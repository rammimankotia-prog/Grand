# .htaccess — Grand Holiday Tours
# Apache configuration for SEO redirects and security

# Enable mod_rewrite
Options -Indexes
RewriteEngine On

# -------------------------------------------------------
# 301 Redirect: /index.html → / (Prevents "Alternative page"
# in Google Search Console caused by duplicate URLs)
# -------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# -------------------------------------------------------
# Force HTTPS (if not already enforced by server config)
# -------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -------------------------------------------------------
# Force non-www → www (if your canonical is non-www, skip this)
# Uncomment the block you need:
# -------------------------------------------------------
# Force www → non-www (use this if canonical = grandholidaytours.com)
RewriteCond %{HTTP_HOST} ^www\.grandholidaytours\.com [NC]
RewriteRule ^(.*)$ https://grandholidaytours.com/$1 [R=301,L]

# -------------------------------------------------------
# Security Headers
# -------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# -------------------------------------------------------
# Cache static assets
# -------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# -------------------------------------------------------
# Enable Gzip compression
# -------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json
</IfModule>
